{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "useDefineForClassFields": true,
    "paths": {
      "@qsense/connector-sdk": ["./packages/connector-sdk/src/index.ts"],
      "@qsense/connector-qq": ["./packages/connector-qq/src/index.ts"]
    },
  },
  "include": ["src", "test", "packages/connector-sdk/src", "packages/connector-qq/src"],
}
