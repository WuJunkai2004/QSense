# qqbot-websocket-mcp 配置样例。复制为 .env 后填写真实值；.env 已 gitignore，严禁提交。

# QQ机器人应用，JSON 数组，支持多bot。appid=开放平台数字AppID，secret=AppSecret（q.qq.com 获取）
# ⚠️ 仅作首次播种源（写入 SQLite bots 表，幂等）：此后增删改以 WebUI / qq_register_bot 为准，改这里不再生效
QQ_APPS=[{"appid":"123456789","secret":"your_app_secret","name":"主bot"}]

# admin token（必填）：首次启动播种进 SQLite（kv admin:token:v1），此后以库为准
# 用途：仅 WebUI /ui/api 登录与管理接口；/mcp 不认它——MCP 客户端须用各 bot 的 agent_token
# 生成：openssl rand -hex 32
MCP_TOKEN=

# MCP 服务监听地址。形态A（本地）保持 127.0.0.1；形态B（VPS 反代/隧道）按需改 0.0.0.0
HOST=127.0.0.1
PORT=8787

# SQLite 数据目录（WAL 模式）
DATA_DIR=./data

# 写操作总开关（仅首次播种默认值；此后以 WebUI 设置页为准，改动即时落库生效）
# 开启后仍需每 bot 群白名单双重门禁（bots.allow_groups，WebUI 设置页管理）
SEND_ENABLE=false

# 写操作白名单（仅首次播种默认值，逗号分隔 group_openid；此后按 bot 在 WebUI 设置页编辑）
ALLOW_GROUPS=

# 机器人认证等级：uncertified（未认证，主动消息 30 条/分钟）| certified（已认证，60 条/分钟）
# 只影响本地令牌桶预算（官方频控前置），不影响被动回复
QQ_AUTH_LEVEL=uncertified

# 日志是否记录消息正文（默认 false；硬约束：生产禁止开启，见 AGENTS.md 禁止事项）
LOG_CONTENT=false

# 日志级别 debug|info|warn|error|fatal
LOG_LEVEL=info

# 缓存消息保留天数（定期清理过期数据，防止无限膨胀）
RETENTION_DAYS=90

# WebUI 静态产物目录（qqbot-webui 仓库，经 junction 挂在 ./ui；构建见 README）
# UI_DIST_DIR=./ui/dist
