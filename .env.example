# qqbot-websocket-mcp 配置样例。复制为 .env 后按需修改；.env 已 gitignore，严禁提交。
#
# M9 起 env 只承担部署拓扑与运维参数——
# bot 注册（appid/secret/认证等级）、admin token、发送开关、群白名单
# 全部以 SQLite（DATA_DIR 下的库）为唯一权威：
#   - bot：经 WebUI「添加机器人」或 MCP 工具 register_bot 注册
#   - admin token：首次启动自动生成并打印一次（登录 WebUI 用）
#   - 发送开关 / 白名单 / 认证等级：WebUI 设置页管理，即时落库生效
# 旧的 QQ_APPS / MCP_TOKEN / SEND_ENABLE / ALLOW_GROUPS / QQ_AUTH_LEVEL 不再被读取。

# MCP 服务监听地址。形态A（本地）保持 127.0.0.1；形态B（VPS 反代/隧道）按需改 0.0.0.0
HOST=127.0.0.1
PORT=8787

# SQLite 数据目录（WAL 模式）。bots 表 / kv（admin token、运行时设置）/ 消息缓存都在这里
DATA_DIR=./data

# 日志是否记录消息正文（默认 false；硬约束：生产禁止开启，见 AGENTS.md 禁止事项）
LOG_CONTENT=false

# 日志级别 debug|info|warn|error|fatal
LOG_LEVEL=info

# 缓存消息保留天数（定期清理过期数据，防止无限膨胀）
RETENTION_DAYS=90

# WebUI 静态产物目录（qqbot-webui 仓库，经 junction 挂在 ./ui；构建见 README）
# UI_DIST_DIR=./ui/dist
